# Contact form email (server-side only — never prefix these with VITE_).
# Copy to .env for local development, and add the same names in your host's
# environment variable settings for production.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
# A Gmail App Password (Google Account → Security → App passwords), not your login password.
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=you@gmail.com
# Where messages are delivered. Defaults to SMTP_FROM.
CONTACT_TO=
